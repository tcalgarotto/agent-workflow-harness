{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workflow Harness: workflow",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "plan",
              "implement",
              "validate",
              "review",
              "integrate"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "uniqueItems": true,
            "minItems": 0,
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "depends_on"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "workflow_id",
    "nodes"
  ],
  "additionalProperties": false
}
