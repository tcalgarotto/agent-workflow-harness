{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workflow Harness: project",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "max_active_runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "minimum_enforcement": {
      "enum": [
        "advised",
        "delivery",
        "execution"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "policy_id",
    "workflow_id",
    "max_active_runs",
    "minimum_enforcement"
  ],
  "additionalProperties": false
}
