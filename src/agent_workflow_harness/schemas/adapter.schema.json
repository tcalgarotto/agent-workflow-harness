{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workflow Harness: adapter",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "enforcement_level": {
      "enum": [
        "advised",
        "delivery",
        "execution"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1000
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "adapter_id",
    "runner",
    "adapter_version",
    "enforcement_level",
    "capabilities",
    "tools"
  ],
  "additionalProperties": false
}
