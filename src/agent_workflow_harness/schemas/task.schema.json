{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Workflow Harness: task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1000
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1000
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1000
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1000
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "workflow_id",
    "adapter_id",
    "objective",
    "acceptance_criteria",
    "allowed_paths",
    "tools",
    "required_capabilities",
    "max_tool_calls"
  ],
  "additionalProperties": false
}
