{
  "schema_version": "1",
  "project_id": "sample-project",
  "policy_id": "development-policy",
  "max_active_runs": 3,
  "minimum_enforcement": "delivery",
  "allowed_tools": [
    "read-files",
    "write-files",
    "run-tests"
  ],
  "writable_paths": [
    "src/",
    "tests/",
    "docs/"
  ],
  "protected_paths": [
    ".git/",
    ".github/",
    ".harness/"
  ],
  "max_tool_calls": 40,
  "required_gates": [
    "validate",
    "review"
  ]
}
